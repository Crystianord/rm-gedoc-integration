# RM API (TOTVS consultaSQLServer)
# Cole aqui a URL completa do endpoint — não appende caminhos depois
RM_QUERY_URL=https://exemplo.rm.cloudtotvs.com.br:8051/api/framework/v1/consultaSQLServer/RealizaConsulta/API.XXX/2/P
# URL alternativa para carga delta (deixe vazio para usar RM_QUERY_URL com parâmetro de data)
RM_QUERY_URL_DELTA=
RM_USERNAME=
RM_PASSWORD=

# GEDOC API — preencha cada URL conforme a documentação do GEDOC/GAP
GEDOC_URL_SEARCH=https://gec-api.sistemasgap.com.br/employees
GEDOC_URL_CREATE=https://gec-api.sistemasgap.com.br/employees
GEDOC_URL_UPDATE=https://gec-api.sistemasgap.com.br/employees   # PUT /{id}
GEDOC_URL_BLOCK=https://gec-api.sistemasgap.com.br/employees    # PUT /{id}/block
GEDOC_API_KEY=
GEDOC_TENANT=
GEDOC_TOKEN=
GEDOC_ACCESS=
GEDOC_EMAIL=
GEDOC_SENHA=

# Dias retroativos para busca delta
DELTA_DAYS=1

# SQL Server (log de processamento)
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
